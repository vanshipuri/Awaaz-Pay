# --- Intent parsing (optional) -------------------------------------------
# Without a key, AwaazPay runs in Smart Demo Mode with its local AI simulator.
GROQ_API_KEY=your_real_groq_key
GROQ_MODEL=llama-3.3-70b-versatile

# --- Razorpay (optional) ---------------------------------------------------
# Without keys, /api/payment/execute returns a simulated S2S mandate capture.
# With test keys, it creates an order and a tokenized UPI AutoPay recurring charge.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret
# The registered UPI AutoPay mandate token created during caregiver setup.
RAZORPAY_UPI_TOKEN_ID=token_xxxxxxxxxxxxxx
RAZORPAY_CUSTOMER_EMAIL=sarla.devi@example.com
RAZORPAY_CUSTOMER_CONTACT=919999999999

# --- Caregiver mandate bounds ---------------------------------------------
MANDATE_PER_TXN_LIMIT=5000
MANDATE_DAILY_LIMIT=15000
WALLET_BALANCE=12500

# --- Voice PIN -------------------------------------------------------------
# Demo passcode for the hands-free loop. Set a real one for a live deployment;
# it is stored only as a salted SHA-256 hash and is never returned with live keys.
AWAAZPAY_VOICE_PIN=1234
AWAAZPAY_PIN_SALT=change-me-in-production
AWAAZPAY_AUTH_SECRET=change-me-in-production
AWAAZPAY_TOKEN_TTL=90
AWAAZPAY_PIN_MAX_ATTEMPTS=3
AWAAZPAY_PIN_LOCK_SECONDS=60

PORT=5173
